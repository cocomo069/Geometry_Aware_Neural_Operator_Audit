# Byte-compiled
__pycache__/
*.py[cod]

# Env
.venv/

# Data & runs (too large for git)
data/raw/
data/processed/
checkpoints/
results/**/*.pt
wandb/

# Fluent runs and large solver artifacts (meshes, cases, data, transcripts).
# The journals, params.json, mesh.json, MANIFEST/RUNBOOK and the small result
# text files (coeffs.out, surface.csv, y+/force reports) are kept; the heavy
# binaries and the regenerable meshes are not.
fluent/runs/
*.msh
*.cas.h5
*.dat.h5
*.cas
*.dat
*.trn
# EnSight Gold field exports (ParaView post) -- regenerable, like the .cas/.dat
*.encas
*.geo
*.scl*
*.vel
fluent/cases/**/*.xml
fluent/runs/**/*.xml

# OS
Thumbs.db
.DS_Store

# session logs
*.err.log
data/cache_build.log
results/g2_train.log

# stray kernel-output extractions
/repo/
logs/
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.pdf
paper/*.synctex.gz
