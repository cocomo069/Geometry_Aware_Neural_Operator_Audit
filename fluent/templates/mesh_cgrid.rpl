# =====================================================================
# mesh_cgrid.rpl -- ICEM CFD Tcl replay: blocked C-grid around a NACA airfoil
# =====================================================================
# FALLBACK / CROSS-CHECK ROUTE ONLY.
#
# The PRIMARY mesher for this study is `fluent/mesh_gen.py` (pure numpy,
# writes a native Fluent 2D .msh directly). See docs/FLUENT_PLAN.md section 2
# for why. Use this replay only if the quality metrics printed by mesh_gen.py
# are judged inadequate for a case -- most plausibly the trailing-edge/wake
# corner on a thick section at high AoA, where an elliptically smoothed ICEM
# block mesh will beat an algebraic one.
#
# ICEM scripting is Tcl (`ic_*` commands); a recorded .rpl replay is exactly a
# Tcl script, so this file is directly runnable via
# mcp__ansys__icemcfd_run_script, or via
#     icemcfd -batch -script mesh_cgrid.rpl
#
# SUBSTITUTION SLOTS (same names as case_template.jou; fill them the same way):
#   {{CHORD}}              chord in metres
#   {{AOA_DEG}}            angle of attack, degrees (airfoil is rotated by -AoA)
#   {{FIRST_CELL_HEIGHT}}  first cell height in metres, from the y+ target
#                          -- compute with mesh_gen.first_cell_height(), do NOT
#                             re-derive it here, so both routes use one formula
#   {{N_SURFACE}}          cells around the airfoil (even)
#   {{N_NORMAL}}           cells in the wall-normal direction
#   {{N_WAKE}}             cells along each wake-cut branch
#   {{GROWTH_NORMAL}}      wall-normal geometric growth ratio
#   {{R_FAR}}              far-field radius, metres
#   {{X_OUT}}              outlet plane x, metres
#   {{CURVE_FILE}}         airfoil contour as an ICEM formatted point/curve file
#                          (write it with mesh_gen.airfoil_loop -> ic_curve)
#   {{OUT_DIR}}            absolute output directory, forward slashes
#   {{CASE_ID}}            case identifier
#
# IMPORTANT: this replay has NOT been executed against a live ICEM. Treat it as
# a structured starting point, not a verified script. `icemcfd_check_mesh`
# returns null counts unless the script prints them, which is why the
# diagnostics at the end are not optional.
# =====================================================================

set out_dir      "{{OUT_DIR}}"
set case_id      "{{CASE_ID}}"
set chord        {{CHORD}}
set aoa          {{AOA_DEG}}
set first_cell   {{FIRST_CELL_HEIGHT}}
set n_surf       {{N_SURFACE}}
set n_norm       {{N_NORMAL}}
set n_wake       {{N_WAKE}}
set growth       {{GROWTH_NORMAL}}
set r_far        {{R_FAR}}
set x_out        {{X_OUT}}

# ---------------------------------------------------------------------
# 1. Project + geometry
# ---------------------------------------------------------------------
ic_unload_tetin
ic_geo_new_family GEOM
ic_boco_clear_icons

# Airfoil contour. Written by mesh_gen.py so both routes share ONE definition
# of the section, the rotation convention and the trailing-edge closure.
ic_load_tetin "{{CURVE_FILE}}"

# Named families, matching the zone names the Fluent journal expects.
foreach fam {AIRFOIL FARFIELD OUTLET FLUID} { ic_geo_new_family $fam }

# Far field: upstream semicircle of radius r_far about the quarter chord,
# closed downstream by two horizontal lines to the outlet plane at x_out.
set xc [expr {0.25 * $chord}]
ic_point {} FARFIELD pcen "$xc,0,0"
ic_point {} FARFIELD pfl  "$xc,-$r_far,0"
ic_point {} FARFIELD pfu  "$xc,$r_far,0"
ic_point {} FARFIELD pfr  "[expr {$xc - $r_far}],0,0"
ic_point {} OUTLET   pol  "$x_out,-$r_far,0"
ic_point {} OUTLET   pou  "$x_out,$r_far,0"

ic_curve arc_ctr_rad FARFIELD cfar "pcen pfl pfu pfr"
ic_curve line OUTLET  clow "pfl pol"
ic_curve line OUTLET  cupp "pfu pou"
ic_curve line OUTLET  cout "pol pou"

# ---------------------------------------------------------------------
# 2. Blocking: initialise 2D, then split into the C topology
# ---------------------------------------------------------------------
ic_hex_initialize_blocking {} FLUID 2D 0
ic_hex_unblank_blocks
# Split once vertically at the trailing edge to separate the O-ring around the
# airfoil from the wake block, then collapse the O-grid onto the section.
ic_hex_split_grid 13 21 [expr {$chord}] m GEOM AIRFOIL FARFIELD OUTLET FLUID
ic_hex_create_ogrid_around_curves {} {} {} AIRFOIL

# Associate block edges to geometry. The associations are what make the mesh
# boundary-fitted; get them wrong and the mesh is silently a box.
ic_hex_set_edge_projection  {} {} 0 1 AIRFOIL
ic_hex_project_to_curve     {} cfar FARFIELD
ic_hex_project_to_curve     {} cout OUTLET

# ---------------------------------------------------------------------
# 3. Node distributions -- this is where the y+ target is enforced
# ---------------------------------------------------------------------
# Wall-normal: exponential/geometric law anchored on the first cell height,
# so the near-wall spacing is set by the y+ target and NOT by an edge count.
ic_hex_set_mesh {} {} n $n_norm h1rel [expr {$first_cell / $r_far}] \
    h2rel 0 r1 $growth r2 2 lmax 0 exp1 copy_to_parallel unlocked
# Around the airfoil: uniform in arc length after the O-grid, clustered at the
# LE and TE by the curve parameterisation inherited from {{CURVE_FILE}}.
ic_hex_set_mesh {} {} n $n_surf h1rel 0 h2rel 0 r1 2 r2 2 lmax 0 \
    geo1 copy_to_parallel unlocked
# Wake: fine at the TE, growing downstream, matched to the TE surface spacing.
ic_hex_set_mesh {} {} n $n_wake h1rel [expr {$first_cell / $x_out}] \
    h2rel 0 r1 1.12 r2 2 lmax 0 exp1 copy_to_parallel unlocked

# ---------------------------------------------------------------------
# 4. Generate, smooth, diagnose
# ---------------------------------------------------------------------
ic_hex_compute_grid {} {} {} n_processors 1
# Elliptic smoothing is the reason this route exists at all: it is what
# relieves the trailing-edge corner that the algebraic route cannot.
ic_hex_smooth 8 nodes_to_move all iterations 8

ic_hex_write_file "$out_dir/${case_id}_hex.uns" GEOM AIRFOIL FARFIELD OUTLET FLUID \
    proj 2 dim_to_mesh 2
ic_uns_load "$out_dir/${case_id}_hex.uns" 3 0 {} 1

# Print diagnostics EXPLICITLY -- icemcfd_check_mesh returns null counts
# otherwise, and "the script finished" is not evidence of a usable mesh.
ic_uns_diagnostic
ic_uns_min_metric Quality {} {}
puts "MESH_NODES [ic_uns_info_node_count]"
puts "MESH_ELEMENTS [ic_uns_info_elem_count]"

# ---------------------------------------------------------------------
# 5. Boundary conditions + Fluent export
# ---------------------------------------------------------------------
# Setting the BC types here means the .msh arrives at Fluent with the same
# zone names and types the journal expects, so no zone renaming in the journal.
ic_boco_set AIRFOIL  {{{1 WALL}}}
ic_boco_set FARFIELD {{{1 VELI}}}
ic_boco_set OUTLET   {{{1 PRESO}}}

ic_uns_num_couplings
ic_save_project_file "$out_dir/${case_id}.prj" [list]
# ICEM's own Fluent output interface -- this is the reason to prefer ICEM when
# it is available: no hand-written .msh exporter is needed.
ic_unload_mesh
ic_hex_write_fluent "$out_dir/${case_id}.msh" 2 0
puts "WROTE $out_dir/${case_id}.msh"
exit
